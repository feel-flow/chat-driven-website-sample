# Resend（https://resend.com/）の API key
RESEND_API_KEY=

# Cloudflare Turnstile（https://dash.cloudflare.com/?to=/:account/turnstile）の Site Key
# PUBLIC_ プレフィックスがついた変数はクライアント bundle に同梱されるため公開してよい値のみ設定
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile の Secret Key（サーバ専用、PUBLIC_ プレフィックスなし）
TURNSTILE_SECRET=

# Resend で verified なドメインの送信元アドレス（例: noreply@your-domain.com）
RESEND_FROM_ADDRESS=

# フォーム送信を受け取る運用者アドレス
CONTACT_TO_ADDRESS=
