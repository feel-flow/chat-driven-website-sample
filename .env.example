# Resend（https://resend.com/）の API key
RESEND_API_KEY=

# Cloudflare Turnstile（https://dash.cloudflare.com/?to=/:account/turnstile）の Site Key
# PUBLIC_ プレフィックスがついた変数はクライアント bundle に同梱されるため公開してよい値のみ設定
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile の Secret Key（サーバ専用、PUBLIC_ プレフィックスなし）
TURNSTILE_SECRET=

# Resend で verified なドメインの送信元アドレス（例: noreply@your-domain.com）
RESEND_FROM_ADDRESS=

# フォーム送信を受け取る運用者アドレス
CONTACT_TO_ADDRESS=

# Vercel Cron 認証用シークレット（任意の長いランダム文字列）
# Vercel Cron Jobs は実行時に `Authorization: Bearer $CRON_SECRET` ヘッダを送付する
# 未設定の場合、cron エンドポイントは認証チェックをスキップする（推奨: 本番では設定）
CRON_SECRET=

# Vercel Deploy Hook URL（cron トリガー時の再ビルドに使用）
# Vercel Dashboard → Project Settings → Git → Deploy Hooks で作成
# 例: https://api.vercel.com/v1/integrations/deploy/prj_xxxx/yyyy
DEPLOY_HOOK_URL=
