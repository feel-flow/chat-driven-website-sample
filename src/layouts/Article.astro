---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  publishedAt?: Date;
  tags?: string[];
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  publishedAt,
  tags,
  backHref,
  backLabel = '一覧へ戻る',
} = Astro.props;

const formattedDate = publishedAt
  ? new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long' }).format(publishedAt)
  : null;
---
<Base title={title} description={description}>
  <article class="article">
    <div class="container">
      <header class="article-header">
        <h1>{title}</h1>
        {formattedDate && (
          <p class="meta">
            <time datetime={publishedAt?.toISOString()}>{formattedDate}</time>
            {tags && tags.length > 0 && (
              <span class="tags">
                {tags.map((tag) => <span class="tag">#{tag}</span>)}
              </span>
            )}
          </p>
        )}
      </header>
      <div class="article-body">
        <slot />
      </div>
      {backHref && (
        <footer class="article-footer">
          <a href={backHref} class="back-link">← {backLabel}</a>
        </footer>
      )}
    </div>
  </article>
</Base>

<style>
  .article {
    padding-block: 3rem;
  }
  .article-header {
    margin-bottom: 2rem;
  }
  .article-header h1 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin: 0 0 0.75rem;
  }
  .meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .tags {
    display: inline-flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tag {
    background: var(--color-surface);
    color: var(--color-accent);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: 0.8rem;
  }
  .article-body {
    background: var(--color-surface);
    padding: 2rem;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    max-width: 740px;
  }
  .article-body :global(h2) {
    font-size: 1.3rem;
    margin-top: 2rem;
  }
  .article-body :global(h3) {
    font-size: 1.1rem;
    margin-top: 1.5rem;
  }
  .article-body :global(a) {
    color: var(--color-accent);
  }
  .article-body :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 1rem 0;
  }
  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .article-body :global(th) {
    background: var(--color-surface-alt);
  }
  .article-footer {
    margin-top: 2rem;
  }
  .back-link {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back-link:hover {
    text-decoration: underline;
  }
</style>
