---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-brand">chat-driven-website-sample</p>
      <p class="footer-tagline">
        生成AI ホームページ運用 ― 書籍サンプルサイト
      </p>
    </div>
    <ul class="footer-links">
      <li><a href="/about">会社案内</a></li>
      <li><a href="/services">サービス</a></li>
      <li><a href="/news">ニュース</a></li>
      <li><a href="/contact">お問い合わせ</a></li>
    </ul>
    <p class="copyright">© {year} chat-driven-website-sample</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: var(--color-on-primary);
    margin-top: 4rem;
  }
  .footer-inner {
    display: grid;
    gap: 1.25rem;
    padding-block: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .footer-inner {
      grid-template-columns: 1.4fr 1fr auto;
      align-items: start;
    }
  }
  .footer-brand {
    margin: 0 0 0.25rem;
    font-weight: 700;
  }
  .footer-tagline {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-links a {
    color: var(--color-on-primary);
    text-decoration: none;
    opacity: 0.9;
    font-size: 0.95rem;
  }
  .footer-links a:hover {
    opacity: 1;
    text-decoration: underline;
  }
  .copyright {
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
